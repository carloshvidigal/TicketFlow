# Copie este arquivo para ".env" e ajuste os valores localmente.
# ".env" nunca é commitado (ver .gitignore).

POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ticketflow
POSTGRES_PORT=5432

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Segredo usado para assinar os JWTs (mínimo 32 bytes). Gere um valor novo:
#   openssl rand -base64 48
JWT_SECRET=
